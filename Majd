<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Effortless Park — UX Redesign</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0a0a;
    --surface: #141414;
    --surface-2: #1c1c1c;
    --surface-3: #242424;
    --border: #2a2a2a;
    --text: #f0f0f0;
    --text-dim: #888;
    --text-muted: #555;
    --accent: #00e676;
    --accent-dim: #00e67622;
    --accent-glow: #00e67644;
    --warning: #ffab40;
    --error: #ff5252;
    --info: #40c4ff;
    --radius: 16px;
    --radius-sm: 10px;
    --radius-xs: 6px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ── Navigation ── */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(10,10,10,0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    padding: 0 40px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: 'Space Mono', monospace;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .nav-links a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--accent); }

  /* ── Hero ── */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 120px 40px 80px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, var(--accent-dim) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-badge {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-dim);
    padding: 8px 20px;
    border-radius: 100px;
    border: 1px solid var(--accent-glow);
    margin-bottom: 40px;
    animation: fadeUp 0.8s ease-out;
  }

  .hero h1 {
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -2px;
    max-width: 900px;
    animation: fadeUp 0.8s ease-out 0.1s both;
  }

  .hero h1 span { color: var(--accent); }

  .hero-sub {
    font-size: 18px;
    color: var(--text-dim);
    max-width: 560px;
    margin-top: 24px;
    font-weight: 300;
    animation: fadeUp 0.8s ease-out 0.2s both;
  }

  .hero-metrics {
    display: flex;
    gap: 48px;
    margin-top: 60px;
    animation: fadeUp 0.8s ease-out 0.3s both;
  }

  .hero-metric {
    text-align: center;
  }

  .hero-metric .number {
    font-family: 'Space Mono', monospace;
    font-size: 36px;
    font-weight: 700;
    color: var(--accent);
  }

  .hero-metric .label {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 4px;
  }

  /* ── Sections ── */
  .section {
    padding: 100px 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-label {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .section-title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -1px;
    line-height: 1.15;
    max-width: 700px;
    margin-bottom: 20px;
  }

  .section-desc {
    font-size: 16px;
    color: var(--text-dim);
    max-width: 600px;
    line-height: 1.7;
    font-weight: 300;
  }

  /* ── Problems Grid ── */
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-top: 60px;
  }

  .problem-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px;
    transition: border-color 0.3s, transform 0.3s;
  }

  .problem-card:hover {
    border-color: var(--error);
    transform: translateY(-2px);
  }

  .problem-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: #ff525215;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    margin-bottom: 20px;
  }

  .problem-card h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .problem-card p {
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .problem-stat {
    margin-top: 16px;
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    color: var(--error);
  }

  /* ── Design Principles ── */
  .principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-top: 60px;
    background: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .principle {
    background: var(--surface);
    padding: 48px 32px;
    text-align: center;
  }

  .principle-number {
    font-family: 'Space Mono', monospace;
    font-size: 48px;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.3;
    margin-bottom: 16px;
  }

  .principle h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .principle p {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.6;
  }

  /* ── Phone Mockup ── */
  .flow-section {
    padding: 100px 40px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .phone-flow {
    display: flex;
    gap: 24px;
    margin-top: 60px;
    overflow-x: auto;
    padding-bottom: 20px;
    scroll-snap-type: x mandatory;
  }

  .phone-flow::-webkit-scrollbar { height: 4px; }
  .phone-flow::-webkit-scrollbar-track { background: var(--surface); border-radius: 2px; }
  .phone-flow::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 2px; }

  .flow-step {
    flex-shrink: 0;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .flow-step-label {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .phone {
    width: 260px;
    height: 520px;
    background: #0d0d0d;
    border-radius: 36px;
    border: 3px solid #333;
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5), inset 0 0 0 1px rgba(255,255,255,0.05);
  }

  .phone-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 24px;
    background: #0d0d0d;
    border-radius: 0 0 16px 16px;
    z-index: 5;
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    background: #111;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .screen-header {
    padding: 36px 20px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .screen-header .back-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface-3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: var(--text-dim);
  }

  .screen-header .title {
    font-size: 15px;
    font-weight: 600;
  }

  .screen-header .step-indicator {
    margin-left: auto;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: var(--text-muted);
  }

  .screen-body {
    flex: 1;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
  }

  .screen-bottom {
    padding: 16px 20px 28px;
  }

  .btn-primary {
    width: 100%;
    padding: 14px;
    background: var(--accent);
    color: #000;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    text-align: center;
  }

  .btn-secondary {
    width: 100%;
    padding: 14px;
    background: var(--surface-3);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    text-align: center;
    margin-top: 10px;
  }

  .btn-ghost {
    width: 100%;
    padding: 12px;
    background: transparent;
    color: var(--text-dim);
    border: none;
    font-size: 13px;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    text-align: center;
    margin-top: 8px;
  }

  /* ── Screen-specific styles ── */
  .welcome-icon {
    width: 64px;
    height: 64px;
    border-radius: 20px;
    background: var(--accent-dim);
    border: 1px solid var(--accent-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    margin: 24px auto 20px;
  }

  .welcome-title {
    font-size: 20px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 6px;
  }

  .welcome-sub {
    font-size: 13px;
    color: var(--text-dim);
    text-align: center;
    margin-bottom: 32px;
  }

  .lang-row {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-bottom: 24px;
  }

  .lang-chip {
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid var(--border);
    font-size: 12px;
    color: var(--text-dim);
    background: var(--surface-2);
  }

  .lang-chip.active {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-dim);
  }

  /* QR Scan screen */
  .scan-zone {
    width: 160px;
    height: 160px;
    margin: 20px auto;
    border-radius: 20px;
    border: 2px dashed var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: var(--accent-dim);
  }

  .scan-zone::before,
  .scan-zone::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 24px;
    border: 3px solid var(--accent);
  }

  .scan-zone::before {
    top: -2px;
    left: -2px;
    border-right: none;
    border-bottom: none;
    border-radius: 8px 0 0 0;
  }

  .scan-zone::after {
    bottom: -2px;
    right: -2px;
    border-left: none;
    border-top: none;
    border-radius: 0 0 8px 0;
  }

  .scan-label {
    font-size: 13px;
    color: var(--text-dim);
    text-align: center;
    margin-top: 16px;
  }

  .scan-hint {
    font-size: 11px;
    color: var(--text-muted);
    text-align: center;
    margin-top: 6px;
  }

  .or-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0;
  }

  .or-divider span {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .or-divider::before,
  .or-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* Time select */
  .preset-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 20px;
  }

  .preset-btn {
    padding: 16px 8px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
  }

  .preset-btn.active {
    border-color: var(--accent);
    background: var(--accent-dim);
  }

  .preset-btn .time {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
  }

  .preset-btn.active .time { color: var(--accent); }

  .preset-btn .price {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .preset-btn.active .price { color: var(--accent); opacity: 0.7; }

  .custom-time-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    margin-bottom: 16px;
  }

  .custom-time-row .icon { font-size: 16px; }
  .custom-time-row .text { font-size: 13px; color: var(--text-dim); flex: 1; }
  .custom-time-row .arrow { color: var(--text-muted); font-size: 12px; }

  /* Confirm screen */
  .confirm-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 20px;
    margin-bottom: 16px;
  }

  .confirm-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
  }

  .confirm-row .label {
    font-size: 13px;
    color: var(--text-dim);
  }

  .confirm-row .value {
    font-size: 14px;
    font-weight: 600;
  }

  .confirm-row + .confirm-row {
    border-top: 1px solid var(--border);
  }

  .confirm-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: var(--accent-dim);
    border: 1px solid var(--accent-glow);
    border-radius: var(--radius-sm);
    margin-bottom: 16px;
  }

  .confirm-total .label {
    font-size: 14px;
    color: var(--accent);
    font-weight: 500;
  }

  .confirm-total .value {
    font-family: 'Space Mono', monospace;
    font-size: 24px;
    font-weight: 700;
    color: var(--accent);
  }

  .nfc-prompt {
    text-align: center;
    padding: 20px;
  }

  .nfc-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 12px;
    border-radius: 50%;
    background: var(--accent-dim);
    border: 2px solid var(--accent-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    animation: pulse-ring 2s ease-out infinite;
  }

  @keyframes pulse-ring {
    0% { box-shadow: 0 0 0 0 var(--accent-glow); }
    70% { box-shadow: 0 0 0 20px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .nfc-text {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .nfc-sub {
    font-size: 12px;
    color: var(--text-muted);
  }

  /* Success screen */
  .success-icon {
    width: 72px;
    height: 72px;
    margin: 32px auto 20px;
    border-radius: 50%;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: #000;
  }

  .success-title {
    font-size: 22px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 4px;
  }

  .success-sub {
    font-size: 13px;
    color: var(--text-dim);
    text-align: center;
    margin-bottom: 24px;
  }

  .receipt-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
  }

  .receipt-row {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 12px;
  }

  .receipt-row .label { color: var(--text-muted); }
  .receipt-row .value { color: var(--text-dim); font-weight: 500; }

  /* Error screen */
  .error-icon {
    width: 56px;
    height: 56px;
    margin: 20px auto 16px;
    border-radius: 50%;
    background: #ff525220;
    border: 2px solid #ff525244;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .error-title {
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    margin-bottom: 6px;
    color: var(--error);
  }

  .error-desc {
    font-size: 13px;
    color: var(--text-dim);
    text-align: center;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .btn-error {
    width: 100%;
    padding: 14px;
    background: var(--error);
    color: #fff;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    text-align: center;
  }

  /* ── Flow Connector ── */
  .flow-connector {
    display: flex;
    align-items: center;
    align-self: center;
    color: var(--text-muted);
    font-size: 20px;
    flex-shrink: 0;
    margin-top: 40px;
  }

  /* ── Feature Comparison ── */
  .comparison {
    margin-top: 60px;
  }

  .comp-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .comp-table th,
  .comp-table td {
    padding: 16px 24px;
    text-align: left;
    font-size: 14px;
    border-bottom: 1px solid var(--border);
  }

  .comp-table th {
    background: var(--surface-2);
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 400;
  }

  .comp-table th:last-child { color: var(--accent); }

  .comp-table td { color: var(--text-dim); }
  .comp-table td:last-child { color: var(--accent); font-weight: 500; }

  .comp-table tr:last-child td { border-bottom: none; }

  /* ── Innovation Cards ── */
  .innovation-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 60px;
  }

  .innovation-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 36px;
    transition: border-color 0.3s;
  }

  .innovation-card:hover { border-color: var(--accent-glow); }

  .innovation-card .tag {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-dim);
    padding: 4px 10px;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 16px;
  }

  .innovation-card h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .innovation-card p {
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .innovation-card.full-width {
    grid-column: 1 / -1;
  }

  /* ── Environment Section ── */
  .env-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 40px;
  }

  .env-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 24px;
  }

  .env-card .icon {
    font-size: 24px;
    margin-bottom: 12px;
  }

  .env-card h4 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .env-card p {
    font-size: 12px;
    color: var(--text-dim);
    line-height: 1.5;
  }

  /* ── Accessibility Section ── */
  .a11y-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .a11y-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    gap: 16px;
  }

  .a11y-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-xs);
    background: var(--accent-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .a11y-card h4 {
    font-size: 14px;
