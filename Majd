              <div class="btn-secondary">Maybe Later</div>
              <div class="btn-ghost">Continue to time selection →</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Error States -->
  <div class="tab-content" id="tab-errors">
    <div class="phone-flow">
      <!-- QR Scan Failure -->
      <div class="flow-step">
        <div class="flow-step-label">QR Scan Failed</div>
        <div class="phone">
          <div class="phone-notch"></div>
          <div class="phone-screen">
