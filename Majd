              <div class="back-btn">←</div>
              <div class="title">Scan Issue</div>
            </div>
            <div class="screen-body" style="justify-content: center;">
              <div class="error-icon">📱</div>
              <div class="error-title">Couldn't read QR code</div>
              <div class="error-desc">This can happen with screen glare or damage. Try holding your phone steady, or enter your plate manually.</div>
            </div>
            <div class="screen-bottom">
              <div class="btn-error" style="background: var(--warning); color: #000;">Try Scanning Again</div>
              <div class="btn-secondary">Enter Plate Manually</div>
            </div>
          </div>
        </div>
      </div>

      <div class="flow-connector" style="margin-top: 40px;">|</div>

      <!-- Payment Declined -->
      <div class="flow-step">
        <div class="flow-step-label">Payment Failed</div>
        <div class="phone">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="screen-header">
              <div class="back-btn">←</div>
              <div class="title">Payment</div>
            </div>
            <div class="screen-body" style="justify-content: center;">
              <div class="error-icon">💳</div>
              <div class="error-title">Payment not completed</div>
              <div class="error-desc">The tap wasn't registered. Hold your card or phone close to the reader for 2 seconds. Make sure NFC is enabled on your phone.</div>
              <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; padding: 14px; margin-top: 8px;">
                <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">TROUBLESHOOTING</div>
                <div style="font-size: 12px; color: var(--text-dim); line-height: 1.6;">
                  • Remove phone case if thick<br>
                  • Hold near the ◉ symbol above<br>
                  • Try a different card
                </div>
              </div>
            </div>
            <div class="screen-bottom">
              <div class="btn-error" style="background: var(--warning); color: #000;">Retry Payment</div>
              <div class="btn-ghost">Use physical card slot instead</div>
            </div>
          </div>
        </div>
      </div>

      <div class="flow-connector" style="margin-top: 40px;">|</div>

      <!-- Connectivity Issue -->
      <div class="flow-step">
        <div class="flow-step-label">Offline Mode</div>
        <div class="phone">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="screen-header">
              <div class="back-btn">←</div>
              <div class="title">Connection Issue</div>
            </div>
            <div class="screen-body" style="justify-content: center;">
              <div class="error-icon">📡</div>
              <div class="error-title">Limited connectivity</div>
              <div class="error-desc">Don't worry — you can still park. Your payment will be processed when connection restores. You'll receive confirmation on screen.</div>
              <div style="background: #40c4ff15; border: 1px solid #40c4ff33; border-radius: 10px; padding: 14px; margin-top: 8px;">
                <div style="font-size: 12px; color: var(--info); font-weight: 500;">ℹ  Offline payments are fully valid. Enforcement officers can verify locally.</div>
              </div>
            </div>
            <div class="screen-bottom">
              <div class="btn-primary">Continue in Offline Mode</div>
            </div>
          </div>
        </div>
      </div>

      <div class="flow-connector" style="margin-top: 40px;">|</div>

      <!-- Session Timeout -->
      <div class="flow-step">
        <div class="flow-step-label">Timeout</div>
        <div class="phone">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="screen-body" style="justify-content: center;">
              <div style="text-align: center;">
                <div style="font-size: 40px; margin-bottom: 16px;">⏰</div>
                <div style="font-size: 16px; font-weight: 600; margin-bottom: 6px;">Still there?</div>
                <div style="font-size: 13px; color: var(--text-dim); margin-bottom: 24px;">Your session will reset in 15 seconds to free the meter for others.</div>
                <div style="width: 100%; height: 4px; background: var(--surface-3); border-radius: 2px; overflow: hidden;">
                  <div style="width: 60%; height: 100%; background: var(--warning); border-radius: 2px;"></div>
                </div>
              </div>
            </div>
